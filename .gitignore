# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
apps/*/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# Playwright
apps/*/test-results/
apps/*/playwright-report/

# api-extractor (contract API audit)
packages/*/dist-api-audit/
packages/contract/etc/temp/

# next.js
/.next/
apps/*/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Neo4j
/neo4j

# Images (will be uploaded to cloud later)
/public/images/uploads
apps/*/public/images/uploads

# Development script files
.dev-server.log
.dev-server.pid

# Playwright MCP test screenshots
.playwright-mcp/*.png
.playwright-mcp/.playwright-mcp/

# Backups (created by setup.sh backup commands)
/backups/

# Development notes
devnotes.txt
