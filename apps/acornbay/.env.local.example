# Template app env (copied to apps/<client>/.env.local.example by scripts/new-client.ts)
# Every storefront is a thin consumer of an @softx/engine instance pointed at
# ITS OWN tenant's Neo4j container (container-per-client, DB-per-client).

# This app's tenant id — MUST match the clientId the data was seeded under.
CLIENT_ID=acornbay

# Neo4j connection for this client's own container.
NEO4J_URI=neo4j://localhost:7601
NEO4J_USER=neo4j
NEO4J_PASSWORD=acornbay123

# ISO-4217 fallback used by the engine when mapping prices (DTOs carry the
# currency explicitly; this is only the default for values without one).
DEFAULT_CURRENCY=LKR

